# ── Email (Nodemailer) ──────────────────────────────────────
# For Gmail: enable "App Passwords" in your Google account,
# then paste the 16-character app password below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password_here

# Where contact-form emails are delivered
CONTACT_TO=you@gmail.com
